# Render Free: DATABASE_URL is set automatically from the linked PostgreSQL database.
# Locally: leave it blank to use SQLite, or set a PostgreSQL connection URL.
DATABASE_URL=
DATABASE_PATH=./data/premii.sqlite
# Render generates SETUP_TOKEN; enter it directly into the app's first-admin setup form.
# Never commit a real token, database URL or password.
SETUP_TOKEN=
